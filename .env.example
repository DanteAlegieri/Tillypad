TILLYPAD_RELAY_API_KEY=change_this_to_a_long_random_secret
TILLYPAD_RELAY_TIMEOUT=15
TILLYPAD_RELAY_RETRIES=2
TILLYPAD_RELAY_CACHE_DIR=.relay_cache
TILLYPAD_RELAY_ALLOW_STALE_CACHE=true
