# Этот файл используется на компьютере рядом с TillyPad SQL Server.
TILLYPAD_SQL_SERVER=127.0.0.1
TILLYPAD_SQL_PORT=1433
TILLYPAD_SQL_DATABASE=TillypadSegment
TILLYPAD_SQL_USER=readonly_user
TILLYPAD_SQL_PASSWORD=change_me
TILLYPAD_SQL_DRIVER=ODBC Driver 18 for SQL Server
TILLYPAD_SQL_ENCRYPT=no
TILLYPAD_SQL_TRUST_CERTIFICATE=yes
TILLYPAD_SQL_TIMEOUT=10

# Сгенерируйте длинный случайный ключ и укажите такой же на Dashboard.
TILLYPAD_RELAY_API_KEY=change_this_to_a_long_random_secret
